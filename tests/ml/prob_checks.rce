    return blr_stats(100, 5, &xm, &y)
fn data_of(k: i64) -> List[f64]
    if k == 0
        return data_rate()
    if k == 1
        return data_eight()
    if k == 2
        return data_kid()
    if k == 3
        return data_blr()
    return data_corr()
fn data_corr() -> List[f64] = [0.99, 1.0, 10.0]

# Checks for lib/ml/prob.rce, generated by scripts/gen/ml_prob_gen.py.
# - posteriordb model densities: value and gradient against PyTorch 2.9
#   float64 autograd of the same unnormalised density;
# - draws: uniform and normal values bit for bit against the Python model
#   of rand.det and Box-Muller (scripts/ref/ml/mlref.py);
# - leapfrog reversibility; split R-hat and ESS against a NumPy
#   implementation of the same formulas; replay of a seeded NUTS run.
# Heavy inference against the posteriordb reference posteriors runs in
# tests/ml/prob_emit.rce (emitted Rust, scripts/check.sh).

fn close(a: f64, b: f64, tol: f64) -> bool
    let s = if b.abs() > 1.0 then b.abs() else 1.0
    return (a - b).abs() <= tol * s

fn all_close(a: &[f64], b: &[f64], tol: f64) -> bool
    if a.len() != b.len()
        return false
    for i in 0..a.len()
        if not close(a[i], b[i], tol)
            return false
    return true

fn lg(k: i64, m: &Model, q: &[f64]) -> (f64, List[f64])
    if k == 0
        return logp_grad(m, rate1, q)
    if k == 1
        return logp_grad(m, eight, q)
    if k == 2
        return logp_grad(m, kid, q)
    if k == 3
        return logp_grad(m, blr, q)
    return logp_grad(m, corr2, q)

# Tolerance 1e-11 relative (blr: 1e-9, its gradient is a difference of
# terms near 1e5 whose float64 rounding differs between the direct
# residual form PyTorch evaluates and the least-squares form used here).
fn density_ref(k: i64, data: List[f64], q: List[f64], want: f64, wg: List[f64]) -> bool
    let m = Model(dim: q.len() as i64, data: data)
    let (v, g) = lg(k, &m, &q)
    let tol = if k == 3 then 1.0e-9 else 1.0e-11
    return close(v, want, tol) and all_close(&g, &wg, tol)

fn seed_of(b: i64) -> List[i64]
    var s: List[i64] = []
    for i in 0..32
        s.push((b + 7 * i) % 256)
    return s

fn uniform_bits(b: i64, stream: i64, want: List[f64]) -> bool
    let sd = seed_of(b)
    var r = rng(&sd, stream)
    for w in want
        let u = uniform(&mut r)
        if u != w
            return false
    return true

fn normal_bits(b: i64, stream: i64, want: List[f64]) -> bool
    let sd = seed_of(b)
    var r = rng(&sd, stream)
    for w in want
        let u = normal(&mut r)
        if u != w
            return false
    return true

# L leapfrog steps forward, momentum negated, L steps back: the start
# state returns to 1e-9 (leapfrog is reversible up to rounding).
fn reversible(data: List[f64], q0: List[f64], p0: List[f64], eps: f64, steps: i64) -> bool
    let m = Model(dim: q0.len() as i64, data: data)
    let minv = unit_metric(q0.len() as i64, false)
    var q = copy(q0)
    var p = copy(p0)
    let (lp, g0) = logp_grad(&m, eight, &q)
    var g = g0
    for _ in 0..steps
        let l = leapfrog(&m, eight, &mut q, &mut p, &mut g, eps, &minv)
    for i in 0..p.len()
        p[i] = 0.0 - p[i]
    for _ in 0..steps
        let l = leapfrog(&m, eight, &mut q, &mut p, &mut g, eps, &minv)
    return all_close(&q, &q0, 1.0e-9)

fn rhat_ref(xs: List[f64], chains: i64, want: f64) -> bool = close(split_rhat(&xs, chains), want, 1.0e-12)
fn ess_ref(xs: List[f64], chains: i64, want: f64) -> bool = close(ess(&xs, chains), want, 1.0e-10)

fn small_run(b: i64, sampler: i64, metric: i64) -> List[List[f64]]
    let m = Model(dim: 2, data: [0.9, 1.0, 3.0])
    # NUTS doubles its trajectory, so its run is shorter and shallower
    let w = if sampler == 1 then 6 else 12
    let dr = if sampler == 1 then 3 else 6
    let md = if sampler == 1 then 3 else 4
    let st = Settings(warmup: w, draws: dr, chains: 2, steps: 4, delta: 0.8, max_depth: md, metric: metric)
    let sd = seed_of(b)
    let q0 = [0.3, -0.2]
    let f = sample(&m, corr2, &q0, &sd, &st, sampler)
    return f.draws

# Replay: one seed gives the same draws twice; another seed differs.
# (Two checks, so each stays inside one comptime fuel budget.)
fn replay(sampler: i64, metric: i64) -> bool = small_run(1, sampler, metric) == small_run(1, sampler, metric)

fn reseed(sampler: i64, metric: i64) -> bool = small_run(1, sampler, metric) != small_run(2, sampler, metric)

# Dense metric pieces against NumPy: the Cholesky factor (and L L^T = A),
# the kinetic energy p^T A p / 2, and momentum draws solving L^T p = z.
fn chol_ref(a: List[f64], d: i64, want: List[f64]) -> bool
    let l = cholesky(&a, d)
    if not all_close(&l, &want, 1.0e-13)
        return false
    for i in 0..d
        for j in 0..d
            var s = 0.0
            for k in 0..d
                s = s + l[(i * d + k) as usize] * l[(j * d + k) as usize]
            if not close(s, a[(i * d + j) as usize], 1.0e-13)
                return false
    return true

fn dense_metric(a: List[f64], d: i64) -> Metric
    let l = cholesky(&a, d)
    return Metric(dense: true, dim: d, minv: a, chol: l)

fn kinetic_ref(a: List[f64], d: i64, p: List[f64], want: f64) -> bool
    let mt = dense_metric(a, d)
    return close(kinetic(&p, &mt), want, 1.0e-13)

fn draw_ref(a: List[f64], d: i64, b: i64) -> bool
    let mt = dense_metric(a, d)
    let sd = seed_of(b)
    var r = rng(&sd, 0)
    var r2 = rng(&sd, 0)
    let p = draw_p(&mut r, &mt)
    for i in 0..d
        var s = 0.0
        for k in 0..d
            s = s + mt.chol[(k * d + i) as usize] * p[k as usize]
        let z = normal(&mut r2)
        if not close(s, z, 1.0e-12)
            return false
    return true

# Leapfrog under a dense metric is reversible too.
fn reversible_dense(a: List[f64], q0: List[f64], p0: List[f64], eps: f64, steps: i64) -> bool
    let m = Model(dim: 2, data: [0.9, 1.0, 3.0])
    let mt = dense_metric(a, 2)
    var q = copy(q0)
    var p = copy(p0)
    let (lp, g0) = logp_grad(&m, corr2, &q)
    var g = g0
    for _ in 0..steps
        let l = leapfrog(&m, corr2, &mut q, &mut p, &mut g, eps, &mt)
    for i in 0..p.len()
        p[i] = 0.0 - p[i]
    for _ in 0..steps
        let l = leapfrog(&m, corr2, &mut q, &mut p, &mut g, eps, &mt)
    return all_close(&q, &q0, 1.0e-9)

fn density_ref_k(k: i64, q: List[f64], want: f64, wg: List[f64]) -> bool = density_ref(k, data_of(k), q, want, wg)

