
# Checks for lib/ml/ad.rce, generated by scripts/gen/ml_ad_gen.py (do not
# edit the vector lines). Per test program and input point:
# - value_bits, grad_bits, jvp_bits: the tape's value, reverse-mode gradient
#   and forward-mode JVP equal, bit for bit, an independent Python model
#   with the same operation order (scripts/ref/ml/mlref.py);
# - grad_ref: the gradient agrees with PyTorch 2.9 float64 autograd (which
#   passed torch.autograd.gradcheck on the same program and agrees with JAX
#   0.6 float64 jax.grad, vectors/ml/ad_ref.tsv) to 1e-11 relative;
# - grad_fd: the gradient agrees with a central finite difference to 1e-6;
# - jvp_dot: forward mode along d equals <reverse gradient, d> to 1e-12;
# - hess_bits, hvp_bits: reverse-over-reverse Hessians and forward-over-
#   reverse Hessian-vector products equal the Python tape model bit for
#   bit; hess_ref: they agree with torch.autograd.functional.hessian
#   (itself within 1e-11 of jax.hessian) to 1e-10; hess_fd: each Hessian
#   row agrees with a central difference of the gradient to 1e-5;
#   grad_tape_bits: the recorded gradient program has the bits of `grad`;
#   third_ref: a third nesting level, d/dx of H[0][0], agrees with
#   PyTorch and JAX triple differentiation to 1e-10.

fn close(a: f64, b: f64, tol: f64) -> bool
    let s = if b.abs() > 1.0 then b.abs() else 1.0
    return (a - b).abs() <= tol * s

fn run(k: i64, x: &[f64]) -> (Tape, i64)
    var t = tape()
    let o = build(k, &mut t, x)
    return (t, o)

fn value_bits(k: i64, x: List[f64], want: f64) -> bool
    let (t, o) = run(k, &x)
    return value(&t, o) == want

fn grad_bits(k: i64, x: List[f64], want: List[f64]) -> bool
    let (t, o) = run(k, &x)
    return grad(&t, o) == want

fn jvp_bits(k: i64, x: List[f64], d: List[f64], want: f64) -> bool
    let (t, o) = run(k, &x)
    return jvp(&t, o, &d) == want

fn grad_ref(k: i64, x: List[f64], want: List[f64]) -> bool
    let (t, o) = run(k, &x)
    let g = grad(&t, o)
    var q: usize = 0
    for w in want
        if not close(g[q], w, 1.0e-11)
            return false
        q += 1
    return true

fn eval_at(k: i64, x: &[f64]) -> f64
    let (t, o) = run(k, x)
    return value(&t, o)

fn grad_fd(k: i64, x: List[f64]) -> bool
    let (t, o) = run(k, &x)
    let g = grad(&t, o)
    for i in 0..x.len()
        let h = 1.0e-6 * (if x[i].abs() > 1.0 then x[i].abs() else 1.0)
        var xp = copy(x)
        var xm = copy(x)
        xp[i] = x[i] + h
        xm[i] = x[i] - h
        let fd = (eval_at(k, &xp) - eval_at(k, &xm)) / (xp[i] - xm[i])
        if not close(fd, g[i], 1.0e-6)
            return false
    return true

fn jvp_dot(k: i64, x: List[f64], d: List[f64]) -> bool
    let (t, o) = run(k, &x)
    let g = grad(&t, o)
    var s = 0.0
    var m = 0.0
    for i in 0..x.len()
        s = s + g[i] * d[i]
        m = m + (g[i] * d[i]).abs()
    let j = jvp(&t, o, &d)
    return (j - s).abs() <= 1.0e-12 * (if m > 1.0 then m else 1.0)

fn flat(h: &List[List[f64]]) -> List[f64]
    var r: List[f64] = []
    for row in h
        for v in row
            r.push(v)
    return r

fn hess_bits(k: i64, x: List[f64], want: List[f64]) -> bool
    let (t, o) = run(k, &x)
    let h = hessian(t, o)
    return flat(&h) == want

fn hvp_bits(k: i64, x: List[f64], d: List[f64], want: List[f64]) -> bool
    let (t, o) = run(k, &x)
    return hvp(t, o, &d) == want

fn hess_ref(k: i64, x: List[f64], want: List[f64], d: List[f64], hv: List[f64]) -> bool
    let (t, o) = run(k, &x)
    let t2 = copy(t)
    let h = hessian(t, o)
    let f = flat(&h)
    for i in 0..f.len()
        if not close(f[i], want[i], 1.0e-10)
            return false
    let v = hvp(t2, o, &d)
    for i in 0..v.len()
        if not close(v[i], hv[i], 1.0e-10)
            return false
    return true

fn hess_fd(k: i64, x: List[f64]) -> bool
    let (t, o) = run(k, &x)
    let h = hessian(t, o)
    for j in 0..x.len()
        let hh = 1.0e-5 * (if x[j].abs() > 1.0 then x[j].abs() else 1.0)
        var xp = copy(x)
        var xm = copy(x)
        xp[j] = x[j] + hh
        xm[j] = x[j] - hh
        let (tp, op) = run(k, &xp)
        let (tm, om) = run(k, &xm)
        let gp = grad(&tp, op)
        let gm = grad(&tm, om)
        for i in 0..x.len()
            let fd = (gp[i] - gm[i]) / (xp[j] - xm[j])
            if not close(fd, h[i as usize][j as usize], 1.0e-5)
                return false
    return true

fn grad_tape_bits(k: i64, x: List[f64]) -> bool
    let (t, o) = run(k, &x)
    let g = grad(&t, o)
    let (t2, gs) = grad_tape(t, o)
    for i in 0..gs.len()
        if value(&t2, gs[i]) != g[i]
            return false
    return true

fn third_ref(k: i64, x: List[f64], want: List[f64]) -> bool
    let (t, o) = run(k, &x)
    let (t1, gs) = grad_tape(t, o)
    let (t2, hs) = grad_tape(t1, gs[0])
    let r = grad(&t2, hs[0])
    for i in 0..r.len()
        if not close(r[i], want[i], 1.0e-10)
            return false
    return true

# max and min split a tie evenly, abs'(0) = 0, and the tape's STEP nodes
# keep second derivatives of piecewise ops at 0.
fn ties() -> bool
    var t = tape()
    let i = input(&mut t, 2.0)
    let j = input(&mut t, 2.0)
    let m = tmax(&mut t, i, j)
    let n = tmin(&mut t, i, j)
    let z = constant(&mut t, 0.0)
    let a = tabs(&mut t, z)
    let ia = add(&mut t, a, i)
    let gm = grad(&t, m)
    let gn = grad(&t, n)
    let ga = grad(&t, ia)
    let t2 = copy(t)
    let h = hessian(t2, m)
    return gm == [0.5, 0.5] and gn == [0.5, 0.5] and ga == [1.0, 0.0] and flat(&h) == [0.0, 0.0, 0.0, 0.0]

# n: 0 exp, 1 ln, 2 expm1, 3 log1p, 4 tanh, 5 sigmoid, 6 softplus, 7 sin, 8 cos, 9 atan
fn elem(n: i64, x: f64) -> f64
    if n == 0
        return exp(x)
    if n == 1
        return ln(x)
    if n == 2
        return expm1(x)
    if n == 3
        return log1p(x)
    if n == 4
        return tanh(x)
    if n == 5
        return sigmoid(x)
    if n == 6
        return softplus(x)
    if n == 7
        return sin(x)
    if n == 8
        return cos(x)
    return atan(x)

fn elem_bits(n: i64, xs: List[f64], want: List[f64]) -> bool
    var q: usize = 0
    for x in xs
        if elem(n, x) != want[q]
            return false
        q += 1
    return true

# Dual numbers and the tape's forward sweep give the same bits on a
# composite of every Dual op (same products, same sum order).
fn dual_matches_tape() -> bool
    let x = 0.7
    let y = -1.3
    let a = dual(x, 1.0)
    let b = dual(y, 0.0)
    let d = dexp(dmul(dtanh(dsub(a, b)), dsin(ddiv(a, dadd(b, dconst(3.0))))))
    let e = dsqrt(dadd(dsigmoid(dcos(a)), dpowi(dln(dadd(dneg(b), dconst(1.0))), 3)))
    var t = tape()
    let i = input(&mut t, x)
    let j = input(&mut t, y)
    let c3 = constant(&mut t, 3.0)
    let c1 = constant(&mut t, 1.0)
    let s1 = sub(&mut t, i, j)
    let s2 = ttanh(&mut t, s1)
    let s3 = add(&mut t, j, c3)
    let s4 = div(&mut t, i, s3)
    let s5 = tsin(&mut t, s4)
    let s6 = mul(&mut t, s2, s5)
    let td = texp(&mut t, s6)
    let u1 = tcos(&mut t, i)
    let u2 = tsigmoid(&mut t, u1)
    let u3 = neg(&mut t, j)
    let u4 = add(&mut t, u3, c1)
    let u5 = tln(&mut t, u4)
    let u6 = tpowi(&mut t, u5, 3)
    let u7 = add(&mut t, u2, u6)
    let te = tsqrt(&mut t, u7)
    let dir = [1.0, 0.0]
    return d.v == value(&t, td) and d.d == jvp(&t, td, &dir) and e.v == value(&t, te) and e.d == jvp(&t, te, &dir)

# relu'(0) = 0 (PyTorch and JAX convention).
fn trelu_zero() -> bool
    var t = tape()
    let i = input(&mut t, 0.0)
    let r = trelu(&mut t, i)
    return grad(&t, r) == [0.0]

# xy_sin
fn build_0(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = mul(t, n0, n1)
    let n3 = tsin(t, n0)
    let n4 = add(t, n2, n3)
    return n4

# exp_over
fn build_1(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = constant(t, 1.0)
    let n3 = tpowi(t, n1, 2)
    let n4 = add(t, n2, n3)
    let n5 = texp(t, n0)
    let n6 = div(t, n5, n4)
    return n6

# tanh_log1p
fn build_2(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = input(t, x[2])
    let n3 = mul(t, n0, n1)
    let n4 = sub(t, n3, n2)
    let n5 = ttanh(t, n4)
    let n6 = tpowi(t, n0, 2)
    let n7 = tlog1p(t, n6)
    let n8 = add(t, n5, n7)
    return n8

# sqrt_softplus
fn build_3(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = input(t, x[2])
    let n3 = tsoftplus(t, n0)
    let n4 = tpowi(t, n1, 2)
    let n5 = add(t, n3, n4)
    let n6 = tsqrt(t, n5)
    let n7 = tsigmoid(t, n2)
    let n8 = mul(t, n6, n7)
    return n8

# cos_gauss_relu
fn build_4(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = input(t, x[2])
    let n3 = tcos(t, n0)
    let n4 = tpowi(t, n1, 2)
    let n5 = constant(t, -0.5)
    let n6 = mul(t, n4, n5)
    let n7 = texp(t, n6)
    let n8 = mul(t, n3, n7)
    let n9 = sub(t, n2, n0)
    let n10 = trelu(t, n9)
    let n11 = sub(t, n8, n10)
    let n12 = texp(t, n1)
    let n13 = constant(t, 1.0)
    let n14 = add(t, n12, n13)
    let n15 = tln(t, n14)
    let n16 = add(t, n11, n15)
    return n16

# neg_div_chain
fn build_5(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = neg(t, n0)
    let n3 = texp(t, n2)
    let n4 = constant(t, 2.0)
    let n5 = add(t, n3, n4)
    let n6 = div(t, n1, n5)
    let n7 = ttanh(t, n6)
    let n8 = tsin(t, n7)
    let n9 = texp(t, n8)
    let n10 = tpowi(t, n9, -3)
    return n10

# rosenbrock4
fn build_6(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = input(t, x[2])
    let n3 = input(t, x[3])
    let n4 = constant(t, 1.0)
    let n5 = constant(t, 100.0)
    let n6 = tpowi(t, n0, 2)
    let n7 = sub(t, n1, n6)
    let n8 = tpowi(t, n7, 2)
    let n9 = mul(t, n5, n8)
    let n10 = sub(t, n4, n0)
    let n11 = tpowi(t, n10, 2)
    let n12 = add(t, n9, n11)
    let n13 = tpowi(t, n1, 2)
    let n14 = sub(t, n2, n13)
    let n15 = tpowi(t, n14, 2)
    let n16 = mul(t, n5, n15)
    let n17 = sub(t, n4, n1)
    let n18 = tpowi(t, n17, 2)
    let n19 = add(t, n16, n18)
    let n20 = tpowi(t, n2, 2)
    let n21 = sub(t, n3, n20)
    let n22 = tpowi(t, n21, 2)
    let n23 = mul(t, n5, n22)
    let n24 = sub(t, n4, n2)
    let n25 = tpowi(t, n24, 2)
    let n26 = add(t, n23, n25)
    let n27 = add(t, n12, n19)
    let n28 = add(t, n27, n26)
    return n28

# mlp_logsumexp
fn build_7(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = input(t, x[2])
    let n3 = input(t, x[3])
    let n4 = input(t, x[4])
    let n5 = input(t, x[5])
    let n6 = input(t, x[6])
    let n7 = input(t, x[7])
    let n8 = input(t, x[8])
    let n9 = input(t, x[9])
    let n10 = input(t, x[10])
    let n11 = mul(t, n2, n0)
    let n12 = mul(t, n3, n1)
    let n13 = add(t, n11, n12)
    let n14 = add(t, n13, n8)
    let n15 = ttanh(t, n14)
    let n16 = texp(t, n15)
    let n17 = mul(t, n4, n0)
    let n18 = mul(t, n5, n1)
    let n19 = add(t, n17, n18)
    let n20 = add(t, n19, n9)
    let n21 = ttanh(t, n20)
    let n22 = texp(t, n21)
    let n23 = mul(t, n6, n0)
    let n24 = mul(t, n7, n1)
    let n25 = add(t, n23, n24)
    let n26 = add(t, n25, n10)
    let n27 = ttanh(t, n26)
    let n28 = texp(t, n27)
    let n29 = add(t, n16, n22)
    let n30 = add(t, n29, n28)
    let n31 = tln(t, n30)
    return n31

# deep21
fn build_8(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = ttanh(t, n0)
    let n2 = texp(t, n1)
    let n3 = tsin(t, n2)
    let n4 = tsigmoid(t, n3)
    let n5 = tcos(t, n4)
    let n6 = tsoftplus(t, n5)
    let n7 = tlog1p(t, n6)
    let n8 = ttanh(t, n7)
    let n9 = texp(t, n8)
    let n10 = tsin(t, n9)
    let n11 = tsigmoid(t, n10)
    let n12 = tcos(t, n11)
    let n13 = tsoftplus(t, n12)
    let n14 = tlog1p(t, n13)
    let n15 = ttanh(t, n14)
    let n16 = texp(t, n15)
    let n17 = tsin(t, n16)
    let n18 = tsigmoid(t, n17)
    let n19 = tcos(t, n18)
    let n20 = tsoftplus(t, n19)
    let n21 = tlog1p(t, n20)
    return n21

# atan_pow
fn build_9(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = input(t, x[2])
    let n3 = tatan(t, n0)
    let n4 = texp(t, n1)
    let n5 = tpow(t, n4, n2)
    let n6 = mul(t, n3, n5)
    let n7 = texpm1(t, n2)
    let n8 = trecip(t, n4)
    let n9 = mul(t, n7, n8)
    let n10 = add(t, n6, n9)
    return n10

# abs_max_min
fn build_10(t: &mut Tape, x: &[f64]) -> i64
    let n0 = input(t, x[0])
    let n1 = input(t, x[1])
    let n2 = input(t, x[2])
    let n3 = tabs(t, n0)
    let n4 = tmax(t, n3, n1)
    let n5 = mul(t, n0, n1)
    let n6 = texpm1(t, n2)
    let n7 = tmin(t, n5, n6)
    let n8 = sub(t, n4, n7)
    let n9 = tpowi(t, n8, 2)
    let n10 = tatan(t, n8)
    let n11 = add(t, n9, n10)
    return n11

fn build(k: i64, t: &mut Tape, x: &[f64]) -> i64
    if k == 0
        return build_0(t, x)
    if k == 1
        return build_1(t, x)
    if k == 2
        return build_2(t, x)
    if k == 3
        return build_3(t, x)
    if k == 4
        return build_4(t, x)
    if k == 5
        return build_5(t, x)
    if k == 6
        return build_6(t, x)
    if k == 7
        return build_7(t, x)
    if k == 8
        return build_8(t, x)
    if k == 9
        return build_9(t, x)
    if k == 10
        return build_10(t, x)
    return build_0(t, x)

check hess_bits(1, [0.9180544757152012, 1.294265628337742], [0.9361860245888177, -0.9058822037882978, -0.9058822037882978, 1.053198752125575])
