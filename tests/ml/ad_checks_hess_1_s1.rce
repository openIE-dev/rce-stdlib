check hess_ref(5, [-0.9198690333268535, 0.21088440953855025], [-0.002124773503593476, -0.2737918148128115, -0.27379181481281145, 0.4001871774548499], [0.15479006906555193, -0.9241184416597557], [0.2526871714066419, -0.41220060472624986])
