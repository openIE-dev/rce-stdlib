check hvp_bits(5, [-0.813015421835049, 1.319297225210494], [0.7575239292071465, -0.9711902167802562], [0.05791866122360234, -0.19250791579607487])
check hess_ref(5, [-0.813015421835049, 1.319297225210494], [0.09051796367507389, 0.010966813811901538, 0.010966813811901583, 0.20677261386703896], [0.7575239292071465, -0.9711902167802562], [0.057918661223602376, -0.19250791579607487])
check hess_fd(5, [-0.813015421835049, 1.319297225210494])
check grad_tape_bits(5, [-0.813015421835049, 1.319297225210494])
