
# Checks for lib/ml/tensor.rce, generated by scripts/gen/ml_tensor_gen.py.
# - reduce/matmul bits: LEFT and PAIRWISE trees equal a Python model of the
#   same tree bit for bit; values agree with PyTorch 2.9 float64;
# - nets: loss and every parameter gradient of small MLPs (tanh/relu/
#   sigmoid, cross entropy and MSE) agree with PyTorch float64 autograd;
#   one gradient entry per net is also checked by central difference;
# - training: parameters after N steps of SGD (momentum, weight decay) and
#   Adam agree with torch.optim from the same initial values;
# - f32 profile: bit patterns against Python struct, and Ferric's
#   fabric_probe digests (rmsnorm_tree: the six-substrate digest published
#   in Ferric docs/determinism/WGPU-DETERMINISM.md; mm: Ferric matmul_cpu,
#   scripts/ref/ml/ferric_probe);
# - placement: the hook's decisions from logged Exact entries.

fn close(a: f64, b: f64, tol: f64) -> bool
    let s = if b.abs() > 1.0 then b.abs() else 1.0
    return (a - b).abs() <= tol * s

fn all_close(a: &[f64], b: &[f64], tol: f64) -> bool
    if a.len() != b.len()
        return false
    for i in 0..a.len()
        if not close(a[i], b[i], tol)
            return false
    return true

fn reduce_bits(xs: List[f64], tree: i64, want: f64) -> bool = same_bits(reduce(&xs, tree), want)

fn matmul_bits(m: i64, k: i64, n: i64, a: List[f64], b: List[f64], tree: i64, want: List[f64], torch_ref: List[f64]) -> bool
    let ta = tensor([m, k], a)
    let tb = tensor([k, n], b)
    let c = matmul(&ta, &tb, tree)
    return c.data == want and all_close(&c.data, &torch_ref, 1.0e-13)

fn lsm_ref(b: i64, c: i64, z: List[f64], want: List[f64]) -> bool
    let t = tensor([b, c], z)
    let l = log_softmax(&t, PAIRWISE)
    return all_close(&l.data, &want, 1.0e-14)

# A two-layer MLP: x[B, i] -> dense(W1, b1) -> act -> dense(W2, b2) ->
# loss (0 cross entropy with labels y, 1 MSE with targets y).
fn build(x: &Tensor, ps: &[Tensor], a: i64, lossk: i64, y: &Tensor, tree: i64) -> (Net, i64)
    var n = net(tree)
    let xi = leaf(&mut n, copy(x))
    let w1 = leaf(&mut n, copy(ps[0]))
    let b1 = leaf(&mut n, copy(ps[1]))
    let w2 = leaf(&mut n, copy(ps[2]))
    let b2 = leaf(&mut n, copy(ps[3]))
    let h = dense(&mut n, xi, w1, b1)
    let ha = act(&mut n, h, a)
    let o = dense(&mut n, ha, w2, b2)
    var l = 0
    if lossk == 0
        l = xent(&mut n, o, copy(y))
    else
        l = mse(&mut n, o, copy(y))
    return (n, l)

fn unpack(i: i64, h: i64, o: i64, p: &[f64]) -> List[Tensor]
    var w1: List[f64] = []
    var b1: List[f64] = []
    var w2: List[f64] = []
    var b2: List[f64] = []
    var q: usize = 0
    for _ in 0..(h * i)
        w1.push(p[q])
        q += 1
    for _ in 0..h
        b1.push(p[q])
        q += 1
    for _ in 0..(o * h)
        w2.push(p[q])
        q += 1
    for _ in 0..o
        b2.push(p[q])
        q += 1
    return [tensor([h, i], w1), tensor([h], b1), tensor([o, h], w2), tensor([o], b2)]

fn flat(ts: &[Tensor]) -> List[f64]
    var r: List[f64] = []
    for t in ts
        for v in t.data
            r.push(v)
    return r

fn grads_of(n: &Net, l: i64) -> List[Tensor]
    let g = backward(n, l)
    return [copy(g[1]), copy(g[2]), copy(g[3]), copy(g[4])]

# shape: [B, i, h, o]; ys: labels (as f64) or targets.
fn net_ref(sh: List[i64], a: i64, lossk: i64, xs: List[f64], ys: List[f64], p: List[f64], want_loss: f64, want_grad: List[f64]) -> bool
    let x = tensor([sh[0], sh[1]], xs)
    let y = if lossk == 0 then tensor([sh[0]], ys) else tensor([sh[0], sh[3]], ys)
    let ps = unpack(sh[1], sh[2], sh[3], &p)
    let (n, l) = build(&x, &ps, a, lossk, &y, PAIRWISE)
    let gs = grads_of(&n, l)
    let g = flat(&gs)
    return close(loss(&n, l), want_loss, 1.0e-13) and all_close(&g, &want_grad, 1.0e-12)

fn loss_at(x: &Tensor, p: &[f64], sh: &[i64], a: i64, lossk: i64, y: &Tensor) -> f64
    let ps = unpack(sh[1], sh[2], sh[3], p)
    let (n, l) = build(x, &ps, a, lossk, y, PAIRWISE)
    return loss(&n, l)

# Central difference on parameter entry j.
fn net_fd(sh: List[i64], a: i64, lossk: i64, xs: List[f64], ys: List[f64], p: List[f64], j: i64) -> bool
    let x = tensor([sh[0], sh[1]], xs)
    let y = if lossk == 0 then tensor([sh[0]], ys) else tensor([sh[0], sh[3]], ys)
    let ps = unpack(sh[1], sh[2], sh[3], &p)
    let (n, l) = build(&x, &ps, a, lossk, &y, PAIRWISE)
    let gs = grads_of(&n, l)
    let g = flat(&gs)
    let h = 1.0e-6
    var pp = copy(p)
    var pm = copy(p)
    pp[j as usize] = p[j as usize] + h
    pm[j as usize] = p[j as usize] - h
    let fd = (loss_at(&x, &pp, &sh, a, lossk, &y) - loss_at(&x, &pm, &sh, a, lossk, &y)) / (pp[j as usize] - pm[j as usize])
    return close(fd, g[j as usize], 1.0e-6)

# The wider op set in one block: x -> dense -> RMSNorm(g) = r;
# softplus(r) gated by sigmoid(dense(r)), plus a residual from the first
# dense, then a dense output and MSE. Parameters in order W1 b1 g Wg bg
# W2 b2; sh = [B, i, h, o].
fn take(p: &[f64], q: i64, n: i64) -> List[f64]
    var r: List[f64] = []
    for k in 0..n
        r.push(p[(q + k) as usize])
    return r

fn build2(x: &Tensor, p: &[f64], sh: &[i64], y: &Tensor) -> (Net, i64)
    let i = sh[1]
    let h = sh[2]
    let o = sh[3]
    var n = net(PAIRWISE)
    let xi = leaf(&mut n, copy(x))
    var q = 0
    let w1 = leaf(&mut n, tensor([h, i], take(p, q, h * i)))
    q += h * i
    let b1 = leaf(&mut n, tensor([h], take(p, q, h)))
    q += h
    let gn = leaf(&mut n, tensor([h], take(p, q, h)))
    q += h
    let wg = leaf(&mut n, tensor([h, h], take(p, q, h * h)))
    q += h * h
    let bg = leaf(&mut n, tensor([h], take(p, q, h)))
    q += h
    let w2 = leaf(&mut n, tensor([o, h], take(p, q, o * h)))
    q += o * h
    let b2 = leaf(&mut n, tensor([o], take(p, q, o)))
    let h1 = dense(&mut n, xi, w1, b1)
    let r = rmsnorm(&mut n, h1, gn, 1.0e-5)
    let sp = act(&mut n, r, N_SOFTPLUS)
    let gz = dense(&mut n, r, wg, bg)
    let gt = act(&mut n, gz, N_SIGMOID)
    let m = emul(&mut n, sp, gt)
    let res = resadd(&mut n, m, h1)
    let out = dense(&mut n, res, w2, b2)
    let l = mse(&mut n, out, copy(y))
    return (n, l)

fn grads2(n: &Net, l: i64) -> List[f64]
    let g = backward(n, l)
    var r: List[f64] = []
    for k in 1..8
        for v in g[k].data
            r.push(v)
    return r

fn net2_ref(sh: List[i64], xs: List[f64], ys: List[f64], p: List[f64], want_loss: f64, want_grad: List[f64]) -> bool
    let x = tensor([sh[0], sh[1]], xs)
    let y = tensor([sh[0], sh[3]], ys)
    let (n, l) = build2(&x, &p, &sh, &y)
    let g = grads2(&n, l)
    return close(loss(&n, l), want_loss, 1.0e-12) and all_close(&g, &want_grad, 1.0e-11)

fn net2_fd(sh: List[i64], xs: List[f64], ys: List[f64], p: List[f64], j: i64) -> bool
    let x = tensor([sh[0], sh[1]], xs)
    let y = tensor([sh[0], sh[3]], ys)
    let (n, l) = build2(&x, &p, &sh, &y)
    let g = grads2(&n, l)
    let hh = 1.0e-6
    var pp = copy(p)
    var pm = copy(p)
    pp[j as usize] = p[j as usize] + hh
    pm[j as usize] = p[j as usize] - hh
    let (np, lp) = build2(&x, &pp, &sh, &y)
    let (nm, lm) = build2(&x, &pm, &sh, &y)
    let fd = (loss(&np, lp) - loss(&nm, lm)) / (pp[j as usize] - pm[j as usize])
    return close(fd, g[j as usize], 1.0e-6)

# opt: 0 SGD(lr, momentum, wd), 1 Adam(lr, 0.9, 0.999, 1e-8, wd).
fn train_ref(sh: List[i64], a: i64, lossk: i64, xs: List[f64], ys: List[f64], p: List[f64], opt: i64, lr: f64, mom: f64, wd: f64, steps: i64, want: List[f64]) -> bool
    let x = tensor([sh[0], sh[1]], xs)
    let y = if lossk == 0 then tensor([sh[0]], ys) else tensor([sh[0], sh[3]], ys)
    var ps = unpack(sh[1], sh[2], sh[3], &p)
    var s = sgd(lr, mom, wd)
    var ad = adam(lr, 0.9, 0.999, 1.0e-8, wd)
    for _ in 0..steps
        let (n, l) = build(&x, &ps, a, lossk, &y, PAIRWISE)
        let g = grads_of(&n, l)
        if opt == 0
            sgd_step(&mut s, &mut ps, &g)
        else
            adam_step(&mut ad, &mut ps, &g)
    let f = flat(&ps)
    return all_close(&f, &want, 1.0e-11)

# The same training run twice gives the same bits (no hidden state).
fn train_twice(sh: List[i64], xs: List[f64], ys: List[f64], p: List[f64]) -> bool
    let x = tensor([sh[0], sh[1]], xs)
    let y = tensor([sh[0]], ys)
    var r: List[List[f64]] = []
    for _ in 0..2
        var ps = unpack(sh[1], sh[2], sh[3], &p)
        var ad = adam(0.01, 0.9, 0.999, 1.0e-8, 0.0)
        for _ in 0..3
            let (n, l) = build(&x, &ps, N_TANH, 0, &y, PAIRWISE)
            let g = grads_of(&n, l)
            adam_step(&mut ad, &mut ps, &g)
        r.push(flat(&ps))
    return r[0] == r[1]

fn bits_ok(xs: List[f64], want: List[i64]) -> bool
    for i in 0..xs.len()
        let v = xs[i] as f32
        if f32_bits(v) != want[i] or f32_from_bits(want[i]) != v
            return false
    return true

fn place_of(class: text, work: f64, calib: List[Calibrated], exacts: List[Exact]) -> text = place(class, work, &calib, &exacts)

fn cal(f: text, c: text, o: f64, th: f64) -> Calibrated = Calibrated(fabric: f, class: c, overhead: o, throughput: th)

# The finite part of the engine's sum.f64 probe: each case's T18 sum has
# the bits the engine computes (scripts/ref/ml/fabric_exec_ref.py).
fn probe_sums(fin: List[f64], lens: List[i64], want: List[u64]) -> bool
    for i in 0..lens.len()
        var xs: List[f64] = []
        for j in 0..lens[i]
            xs.push(fin[j as usize])
        let nc: List[Calibrated] = []
        let ne: List[Exact] = []
        let (f, v) = placed_sum(&xs, &nc, &ne)
        if f != "cpu" or f64_bits(v) != want[i]
            return false
    return true

# The finite lanes of a lanes.f64 probe, bit for bit.
fn probe_lanes(op: i64, a: List[f64], b: List[f64], want: List[u64]) -> bool
    for i in 0..a.len()
        let x = a[i]
        let y = b[i]
        let r = if op == 0 then x + y else (if op == 1 then x - y else (if op == 2 then x * y else (if op == 3 then x / y else (if op == 4 then -x else x.sqrt()))))
        if f64_bits(r) != want[i]
            return false
    return true

fn tree_split(xs: List[f64]) -> bool = not same_bits(reduce(&xs, PAIRWISE), reduce(&xs, T18))

# relu'(0) = 0 in the tensor tape (PyTorch's convention).
fn relu_zero_grad() -> bool
    var n = net(LEFT)
    let x = leaf(&mut n, tensor([1, 2], [0.0, 1.0]))
    let r = act(&mut n, x, N_RELU)
    let l = mse(&mut n, r, tensor([1, 2], [-1.0, 0.0]))
    let g = backward(&n, l)
    return g[0].data == [0.0, 1.0]

fn bits64_ok(xs: List[f64], want: List[u64]) -> bool
    for i in 0..xs.len()
        if f64_bits(xs[i]) != want[i]
            return false
    return true

fn trees_differ(xs: List[f64]) -> bool = reduce(&xs, LEFT) != reduce(&xs, PAIRWISE)
fn ex(f: text, c: text, d: text) -> Exact = Exact(fabric: f, class: c, probe: copy(d), reference: d)

