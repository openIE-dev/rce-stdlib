module ml.tensor
# uses: ml.ad
use ml.ad

# Deterministic tensors, layers and optimizers (ml.tensor,
# spec/proposals/ml.md). A Tensor is a shape and a row-major ravel of f64.
# Every reduction names its tree (LEFT: a left fold in index order from
# the first element, the default of proposed rule N-9; PAIRWISE: split at
# n/2, recursively; T18: the engine's fixed tree), so the shape and the
# tree, never a schedule, fix the bits. Products are rounded before they are added (no contraction).
#
# Gradients come from a tensor-level tape (`Net`) whose vector-Jacobian
# products are written per operation (matmul, bias, activations, MSE,
# softmax cross entropy), checked against PyTorch float64 autograd and
# against finite differences.
#
# Placement hook (Appendix E HC-12/HC-13, the engine's FabricExec): sums
# (tree T18) and lane-wise ops belong to the engine's placement classes;
# `place` sends one to a fabric, such as a wgpu backend, only when the log
# holds a host.Calibrated row and a host.Exact probe for that fabric and
# class whose digest equals the reference digest; everything else runs on
# the reference. The f32 profile below (binary32 computed in f64 and
# rounded once per operation, 6.3 N3) reproduces Ferric's probe kernels
# bit for bit, and `probe_digest` is Ferric's FNV-1a over the f32 bits.

pub const LEFT: i64 = 0
pub const PAIRWISE: i64 = 1
pub const T18: i64 = 2

pub struct Tensor
    shape: List[i64]
    data: List[f64]

error BadShape(what: text)

pub fn tensor(shape: List[i64], data: List[f64]) -> Tensor = Tensor(shape: shape, data: data)

pub fn numel(shape: &[i64]) -> i64
    var n = 1
    for d in shape
        n = n * d
    return n

pub fn full(shape: List[i64], v: f64) -> Tensor
    var d: List[f64] = []
    for _ in 0..numel(&shape)
        d.push(v)
    return Tensor(shape: shape, data: d)

pub fn zeros(shape: List[i64]) -> Tensor = full(shape, 0.0)
pub fn zeros_like(t: &Tensor) -> Tensor = full(copy(t.shape), 0.0)

pub fn rows(t: &Tensor) -> i64 = t.shape[0]
pub fn cols(t: &Tensor) -> i64 = t.shape[1]

# ---------------------------------------------------------------- reductions

fn pw(xs: &[f64], lo: usize, hi: usize) -> f64 bound 64
    let n = hi - lo
    if n == 1
        return xs[lo]
    let mid = lo + n / 2
    return pw(xs, lo, mid) + pw(xs, mid, hi)

# T18 (engine host.rs fixed_tree_sum): split at the largest power of two
# strictly below the length, so the shape is fixed by the length alone.
fn t18(xs: &[f64], lo: usize, hi: usize) -> f64 bound 64
    let n = hi - lo
    if n == 1
        return xs[lo]
    var h: usize = 1
    while h * 2 < n bound 64
        h = h * 2
    return t18(xs, lo, lo + h) + t18(xs, lo + h, hi)

# Sum of xs under the named tree; the empty sum is 0.
pub fn reduce(xs: &[f64], tree: i64) -> f64
    if xs.len() == 0
        return 0.0
    if tree == PAIRWISE
        return pw(xs, 0, xs.len())
    if tree == T18
        return t18(xs, 0, xs.len())
    var s = xs[0]
    var i: usize = 1
    while i < xs.len() bound 1099511627776
        s = s + xs[i]
        i += 1
    return s

pub fn sum(t: &Tensor, tree: i64) -> f64 = reduce(&t.data, tree)
pub fn mean(t: &Tensor, tree: i64) -> f64 = reduce(&t.data, tree) / (t.data.len() as f64)

# Dot product: products rounded, then reduced by the tree.
pub fn dot(a: &[f64], b: &[f64], tree: i64) -> f64
    var p: List[f64] = []
    for i in 0..a.len()
        p.push(a[i] * b[i])
    return reduce(&p, tree)

# ---------------------------------------------------------------- elementwise

pub fn zip(a: &Tensor, b: &Tensor, op: i64) -> Tensor
    var d: List[f64] = []
    for i in 0..a.data.len()
        let x = a.data[i]
        let y = b.data[i]
        d.push(if op == 0 then x + y else (if op == 1 then x - y else x * y))
    return Tensor(shape: copy(a.shape), data: d)

pub fn tadd(a: &Tensor, b: &Tensor) -> Tensor = zip(a, b, 0)
pub fn tsub(a: &Tensor, b: &Tensor) -> Tensor = zip(a, b, 1)
pub fn tmul(a: &Tensor, b: &Tensor) -> Tensor = zip(a, b, 2)

pub fn scale(a: &Tensor, s: f64) -> Tensor
    var d: List[f64] = []
    for x in a.data
        d.push(x * s)
    return Tensor(shape: copy(a.shape), data: d)

# Unary maps: 0 relu, 1 tanh, 2 sigmoid, 3 exp, 4 softplus.
fn un(f: i64, x: f64) -> f64
    if f == 0
        return if x > 0.0 then x else 0.0
    if f == 1
        return ad.tanh(x)
    if f == 2
        return ad.sigmoid(x)
    if f == 3
        return ad.exp(x)
    return ad.softplus(x)

pub fn map(a: &Tensor, f: i64) -> Tensor
    var d: List[f64] = []
    for x in a.data
        d.push(un(f, x))
    return Tensor(shape: copy(a.shape), data: d)

# ---------------------------------------------------------------- matrices

pub fn transpose(a: &Tensor) -> Tensor
    let m = a.shape[0]
    let n = a.shape[1]
    var d: List[f64] = []
    for j in 0..n
        for i in 0..m
            d.push(a.data[(i * n + j) as usize])
    return Tensor(shape: [n, m], data: d)

# C[m, n] = A[m, k] B[k, n]; each entry is dot(row, column) under `tree`.
pub fn matmul(a: &Tensor, b: &Tensor, tree: i64) -> Tensor
    let m = a.shape[0]
    let k = a.shape[1]
    let n = b.shape[1]
    var d: List[f64] = []
    var col: List[f64] = []
    var p: List[f64] = []
    for i in 0..m
        for j in 0..n
            p = []
            for q in 0..k
                p.push(a.data[(i * k + q) as usize] * b.data[(q * n + j) as usize])
            d.push(reduce(&p, tree))
    return Tensor(shape: [m, n], data: d)

# Y[B, o] = X[B, i] W[o, i]^T (the PyTorch Linear layout).
pub fn matmul_nt(x: &Tensor, w: &Tensor, tree: i64) -> Tensor
    let bsz = x.shape[0]
    let k = x.shape[1]
    let o = w.shape[0]
    var d: List[f64] = []
    var p: List[f64] = []
    for i in 0..bsz
        for j in 0..o
            p = []
            for q in 0..k
                p.push(x.data[(i * k + q) as usize] * w.data[(j * k + q) as usize])
            d.push(reduce(&p, tree))
    return Tensor(shape: [bsz, o], data: d)

# Y[B, o] + b[o], the broadcast written out (a named operation, not an
# implicit stretch).
pub fn add_row(y: &Tensor, b: &Tensor) -> Tensor
    let o = y.shape[1]
    var d: List[f64] = []
    for i in 0..y.data.len()
        d.push(y.data[i] + b.data[(i as i64 % o) as usize])
    return Tensor(shape: copy(y.shape), data: d)

# Column sums of Y[B, o] under `tree` (the bias gradient).
pub fn sum_rows(y: &Tensor, tree: i64) -> Tensor
    let bsz = y.shape[0]
    let o = y.shape[1]
    var d: List[f64] = []
    var c: List[f64] = []
    for j in 0..o
        c = []
        for i in 0..bsz
            c.push(y.data[(i * o + j) as usize])
        d.push(reduce(&c, tree))
    return Tensor(shape: [o], data: d)

# Row-wise softmax and log-softmax, max-shifted.
pub fn log_softmax(z: &Tensor, tree: i64) -> Tensor
    let bsz = z.shape[0]
    let c = z.shape[1]
    var d: List[f64] = []
    var e: List[f64] = []
    for i in 0..bsz
        var mx = z.data[(i * c) as usize]
        for j in 0..c
            mx = mx.max(z.data[(i * c + j) as usize])
        e = []
        for j in 0..c
            e.push(ad.exp(z.data[(i * c + j) as usize] - mx))
        let lse = ad.ln(reduce(&e, tree))
        for j in 0..c
            d.push((z.data[(i * c + j) as usize] - mx) - lse)
    return Tensor(shape: copy(z.shape), data: d)

pub fn softmax(z: &Tensor, tree: i64) -> Tensor
    let l = log_softmax(z, tree)
    return map(&l, 3)

# ---------------------------------------------------------------- layers and tape

# Node kinds of the tensor tape.
pub const LEAF: i64 = 0
pub const LINEAR_NT: i64 = 1
pub const ADD_ROW: i64 = 2
pub const N_RELU: i64 = 3
pub const N_TANH: i64 = 4
pub const N_SIGMOID: i64 = 5
pub const MSE: i64 = 6
pub const XENT: i64 = 7
pub const N_SOFTPLUS: i64 = 8
pub const RESADD: i64 = 9
pub const EMUL: i64 = 10
pub const RMSNORM: i64 = 11

# A tensor tape. Node i: kd, args a, b (-1 if absent), value, and for
# MSE / XENT the fixed target (a tensor, or labels as f64 class indices).
pub struct Net
    kd: List[i64]
    a: List[i64]
    b: List[i64]
    val: List[Tensor]
    tgt: List[Tensor]
    tree: i64

pub fn net(tree: i64) -> Net = Net(kd: [], a: [], b: [], val: [], tgt: [], tree: tree)

fn put(n: &mut Net, k: i64, a: i64, b: i64, v: Tensor, t: Tensor) -> i64
    n.kd.push(k)
    n.a.push(a)
    n.b.push(b)
    n.val.push(v)
    n.tgt.push(t)
    return (n.val.len() as i64) - 1

fn empty_t() -> Tensor = Tensor(shape: [0], data: [])

pub fn leaf(n: &mut Net, t: Tensor) -> i64 = put(n, LEAF, -1, -1, t, empty_t())

pub fn val(n: &Net, i: i64) -> Tensor = copy(n.val[i as usize])

pub fn dense_nt(n: &mut Net, x: i64, w: i64) -> i64
    let v = matmul_nt(&n.val[x as usize], &n.val[w as usize], n.tree)
    return put(n, LINEAR_NT, x, w, v, empty_t())

pub fn bias(n: &mut Net, y: i64, b: i64) -> i64
    let v = add_row(&n.val[y as usize], &n.val[b as usize])
    return put(n, ADD_ROW, y, b, v, empty_t())

pub fn act(n: &mut Net, x: i64, kd: i64) -> i64
    let f = if kd == N_RELU then 0 else (if kd == N_TANH then 1 else (if kd == N_SIGMOID then 2 else 4))
    let v = map(&n.val[x as usize], f)
    return put(n, kd, x, -1, v, empty_t())

# Elementwise sum (a residual connection) and product (a gate) of two
# nodes of one shape.
pub fn resadd(n: &mut Net, x: i64, y: i64) -> i64
    let v = tadd(&n.val[x as usize], &n.val[y as usize])
    return put(n, RESADD, x, y, v, empty_t())

pub fn emul(n: &mut Net, x: i64, y: i64) -> i64
    let v = tmul(&n.val[x as usize], &n.val[y as usize])
    return put(n, EMUL, x, y, v, empty_t())

# Row-wise RMS normalisation with a weight (torch.nn.functional.rms_norm):
# y = (x r) w, r = 1 / sqrt(mean(x^2) + eps), the mean a tree reduction.
fn rms_rows(x: &Tensor, tree: i64, eps: f64) -> List[f64]
    let bsz = x.shape[0]
    let d = x.shape[1]
    var rs: List[f64] = []
    var sq: List[f64] = []
    for i in 0..bsz
        sq = []
        for j in 0..d
            let v = x.data[(i * d + j) as usize]
            sq.push(v * v)
        let ms = reduce(&sq, tree) / (d as f64)
        rs.push(1.0 / (ms + eps).sqrt())
    return rs

pub fn rmsnorm(n: &mut Net, x: i64, w: i64, eps: f64) -> i64
    let xv = &n.val[x as usize]
    let wv = &n.val[w as usize]
    let rs = rms_rows(xv, n.tree, eps)
    let d = xv.shape[1]
    var o: List[f64] = []
    for i in 0..xv.shape[0]
        for j in 0..d
            o.push((xv.data[(i * d + j) as usize] * rs[i as usize]) * wv.data[j as usize])
    let v = Tensor(shape: copy(xv.shape), data: o)
    return put(n, RMSNORM, x, w, v, Tensor(shape: [1], data: [eps]))

# Linear layer y = x W^T + b (PyTorch nn.Linear).
pub fn dense(n: &mut Net, x: i64, w: i64, b: i64) -> i64
    let y = dense_nt(n, x, w)
    return bias(n, y, b)

# Mean squared error over all elements (reduction "mean").
pub fn mse(n: &mut Net, p: i64, target: Tensor) -> i64
    let d = tsub(&n.val[p as usize], &target)
    let sq = tmul(&d, &d)
    let v = mean(&sq, n.tree)
    return put(n, MSE, p, -1, Tensor(shape: [1], data: [v]), target)

# Softmax cross entropy, mean over the batch (nn.CrossEntropyLoss).
pub fn xent(n: &mut Net, z: i64, labels: Tensor) -> i64
    let ls = log_softmax(&n.val[z as usize], n.tree)
    let c = ls.shape[1]
    var terms: List[f64] = []
    for i in 0..ls.shape[0]
        terms.push(0.0 - ls.data[(i * c + (labels.data[i as usize] as i64)) as usize])
    let v = reduce(&terms, n.tree) / (terms.len() as f64)
    return put(n, XENT, z, -1, Tensor(shape: [1], data: [v]), labels)

pub fn loss(n: &Net, i: i64) -> f64 = n.val[i as usize].data[0]

fn accum(g: &mut List[Tensor], i: i64, d: Tensor)
    let u = i as usize
    if g[u].data.len() == 0
        g[u] = d
    else
        g[u] = tadd(&g[u], &d)

# Reverse sweep from the scalar node `out`: the gradient of every node
# (an empty tensor for nodes the output does not depend on). Gradients
# that meet at a node are added in the order the sweep reaches them.
pub fn backward(n: &Net, out: i64) -> List[Tensor]
    var g: List[Tensor] = []
    for _ in 0..n.val.len()
        g.push(empty_t())
    g[out as usize] = Tensor(shape: [1], data: [1.0])
    var i = out
    while i >= 0 bound 1099511627776
        let u = i as usize
        let k = n.kd[u]
        if g[u].data.len() > 0 and k != LEAF
            let gy = copy(g[u])
            let xa = n.a[u]
            if k == LINEAR_NT
                let x = &n.val[xa as usize]
                let w = &n.val[n.b[u] as usize]
                accum(&mut g, xa, matmul(&gy, w, n.tree))
                let gyt = transpose(&gy)
                accum(&mut g, n.b[u], matmul(&gyt, x, n.tree))
            if k == ADD_ROW
                accum(&mut g, xa, copy(gy))
                accum(&mut g, n.b[u], sum_rows(&gy, n.tree))
            if k == N_RELU
                let x = &n.val[xa as usize]
                var d: List[f64] = []
                for q in 0..x.data.len()
                    d.push(if x.data[q] > 0.0 then gy.data[q] else 0.0)
                accum(&mut g, xa, Tensor(shape: copy(x.shape), data: d))
            if k == N_TANH or k == N_SIGMOID
                let y = &n.val[u]
                var d: List[f64] = []
                for q in 0..y.data.len()
                    let s = y.data[q]
                    d.push(gy.data[q] * (if k == N_TANH then 1.0 - s * s else s * (1.0 - s)))
                accum(&mut g, xa, Tensor(shape: copy(y.shape), data: d))
            if k == N_SOFTPLUS
                let x = &n.val[xa as usize]
                var d: List[f64] = []
                for q in 0..x.data.len()
                    d.push(gy.data[q] * ad.sigmoid(x.data[q]))
                accum(&mut g, xa, Tensor(shape: copy(x.shape), data: d))
            if k == RESADD
                accum(&mut g, xa, copy(gy))
                accum(&mut g, n.b[u], copy(gy))
            if k == EMUL
                let ga = tmul(&gy, &n.val[n.b[u] as usize])
                let gb = tmul(&gy, &n.val[xa as usize])
                accum(&mut g, xa, ga)
                accum(&mut g, n.b[u], gb)
            if k == RMSNORM
                let x = &n.val[xa as usize]
                let w = &n.val[n.b[u] as usize]
                let rs = rms_rows(x, n.tree, n.tgt[u].data[0])
                let bsz = x.shape[0]
                let dd = x.shape[1]
                var gx: List[f64] = []
                var hx: List[f64] = []
                for ri in 0..bsz
                    let r = rs[ri as usize]
                    hx = []
                    for j in 0..dd
                        let at = (ri * dd + j) as usize
                        hx.push((gy.data[at] * w.data[j as usize]) * x.data[at])
                    let sdot = reduce(&hx, n.tree)
                    let c = ((r * r) * r / (dd as f64)) * sdot
                    for j in 0..dd
                        let at = (ri * dd + j) as usize
                        gx.push(r * (gy.data[at] * w.data[j as usize]) - c * x.data[at])
                # weight gradient: column sums of gy * (x r) in row order
                var col: List[f64] = []
                var gwt: List[f64] = []
                for j in 0..dd
                    col = []
                    for ri in 0..bsz
                        let at = (ri * dd + j) as usize
                        col.push(gy.data[at] * (x.data[at] * rs[ri as usize]))
                    gwt.push(reduce(&col, n.tree))
                accum(&mut g, xa, Tensor(shape: copy(x.shape), data: gx))
                accum(&mut g, n.b[u], Tensor(shape: [dd], data: gwt))
            if k == MSE
                let p = &n.val[xa as usize]
                let c = 2.0 / (p.data.len() as f64)
                var d: List[f64] = []
                for q in 0..p.data.len()
                    d.push(gy.data[0] * (c * (p.data[q] - n.tgt[u].data[q])))
                accum(&mut g, xa, Tensor(shape: copy(p.shape), data: d))
            if k == XENT
                let z = &n.val[xa as usize]
                let sm = softmax(z, n.tree)
                let bsz = z.shape[0]
                let c = z.shape[1]
                var d: List[f64] = []
                for r in 0..bsz
                    let lab = n.tgt[u].data[r as usize] as i64
                    for j in 0..c
                        let one = if j == lab then 1.0 else 0.0
                        d.push(gy.data[0] * ((sm.data[(r * c + j) as usize] - one) / (bsz as f64)))
                accum(&mut g, xa, Tensor(shape: copy(z.shape), data: d))
        i -= 1
    return g

# ---------------------------------------------------------------- optimizers

# SGD with momentum and weight decay, PyTorch torch.optim.SGD semantics
# (dampening 0, no Nesterov): g' = g + wd p; b = mu b + g' (b = g' on the
# first t); p = p - lr b.
pub struct Sgd
    lr: f64
    momentum: f64
    wd: f64
    buf: List[Tensor]
    nstep: i64

pub fn sgd(lr: f64, momentum: f64, wd: f64) -> Sgd = Sgd(lr: lr, momentum: momentum, wd: wd, buf: [], nstep: 0)

pub fn sgd_step(o: &mut Sgd, params: &mut List[Tensor], grads: &[Tensor])
    for i in 0..params.len()
        var g = copy(grads[i])
        if o.wd != 0.0
            let wdp = scale(&params[i], o.wd)
            g = tadd(&g, &wdp)
        if o.momentum != 0.0
            if o.nstep == 0
                o.buf.push(copy(g))
            else
                let mb = scale(&o.buf[i], o.momentum)
                o.buf[i] = tadd(&mb, &g)
            g = copy(o.buf[i])
        let upd = scale(&g, o.lr)
        params[i] = tsub(&params[i], &upd)
    o.nstep += 1

# Adam, PyTorch torch.optim.Adam semantics (amsgrad off, weight decay
# added to the gradient): m = b1 m + (1-b1) g; v = b2 v + (1-b2) g^2;
# p = p - (lr / (1 - b1^t)) m / (sqrt(v) / sqrt(1 - b2^t) + eps).
pub struct Adam
    lr: f64
    b1: f64
    b2: f64
    eps: f64
    wd: f64
    m: List[Tensor]
    v: List[Tensor]
    nstep: i64

pub fn adam(lr: f64, b1: f64, b2: f64, eps: f64, wd: f64) -> Adam = Adam(lr: lr, b1: b1, b2: b2, eps: eps, wd: wd, m: [], v: [], nstep: 0)

pub fn adam_step(o: &mut Adam, params: &mut List[Tensor], grads: &[Tensor])
    o.nstep += 1
    let bc1 = 1.0 - ad.powi(o.b1, o.nstep)
    let bc2 = 1.0 - ad.powi(o.b2, o.nstep)
    let step_size = o.lr / bc1
    let bc2s = bc2.sqrt()
    for i in 0..params.len()
        var g = copy(grads[i])
        if o.wd != 0.0
            let wdp = scale(&params[i], o.wd)
            g = tadd(&g, &wdp)
        if o.nstep == 1
            o.m.push(zeros_like(&g))
            o.v.push(zeros_like(&g))
        var m: List[f64] = []
        var v: List[f64] = []
        var p: List[f64] = []
        for q in 0..g.data.len()
            let gq = g.data[q]
            let mq = o.m[i].data[q] * o.b1 + gq * (1.0 - o.b1)
            let vq = o.v[i].data[q] * o.b2 + (gq * gq) * (1.0 - o.b2)
            m.push(mq)
            v.push(vq)
            let denom = vq.sqrt() / bc2s + o.eps
            p.push(params[i].data[q] - step_size * (mq / denom))
        o.m[i] = Tensor(shape: copy(g.shape), data: m)
        o.v[i] = Tensor(shape: copy(g.shape), data: v)
        params[i] = Tensor(shape: copy(g.shape), data: p)

# ---------------------------------------------------------------- f32 profile and placement

const M32: u64 = 4294967295

# a * b mod 2^64 from 32-bit limbs (u64 arithmetic traps on overflow).
pub fn wmul(a: u64, b: u64) -> u64
    let al = a & M32
    let ah = a >> 32
    let bl = b & M32
    let bh = b >> 32
    let lo = al * bl
    let cross = ((al * bh) & M32) + ((ah * bl) & M32)
    let hi = ((lo >> 32) + cross) & M32
    return (hi << 32) | (lo & M32)

# The sign bit of x, -0.0 included. Comparison cannot see the sign of a
# zero (6.3: -0.0 == 0.0), but F6 makes it observable through f32 text,
# which prints "-0"; this is exact on every target.
pub fn signbit(x: f64) -> bool
    if x != 0.0
        return x < 0.0
    let f = x as f32
    return f.tostr() == "-0"

# The binary32 bit pattern of x, sign of zero included.
pub fn f32_bits(x: f32) -> i64
    let v = x as f64
    let sg = if signbit(v) then 2147483648 else 0
    if v == 0.0
        return sg
    let a = v.abs()
    let e = ad.ilogb(a)
    if e < -126
        return sg | (ad.ldexp(a, 149) as i64)
    let mant = (ad.ldexp(a, 23 - e) as i64) - 8388608
    return sg | ((e + 127) << 23) | mant

# The binary64 bit pattern of a finite x, sign of zero included.
pub fn f64_bits(x: f64) -> u64
    let sg: u64 = if signbit(x) then 9223372036854775808 else 0
    if x == 0.0
        return sg
    let a = x.abs()
    let e = ad.ilogb(a)
    if e < -1022
        return sg | (ad.ldexp(a, 1074) as u64)
    let mant = (ad.ldexp(a, 52 - e) as u64) - 4503599627370496
    return sg | (((e + 1023) as u64) << 52) | mant

# Raw-bit equality: tells -0.0 from 0.0, unlike ==.
pub fn same_bits(a: f64, b: f64) -> bool = f64_bits(a) == f64_bits(b)

pub fn hex16(h: u64) -> text
    let hx = "0123456789abcdef".chars()
    var s = ""
    var k = 60
    while k >= 0 bound 17
        let d = ((h >> (k as u64)) & 15) as usize
        s = s + copy(hx[d])
        k -= 4
    return s

pub fn f32_from_bits(b: i64) -> f32
    let sg = if (b >> 31) & 1 == 1 then -1.0 else 1.0
    let e = (b >> 23) & 255
    let m = b & 8388607
    if e == 0
        return (sg * ad.ldexp(m as f64, -149)) as f32
    return (sg * ad.ldexp((m + 8388608) as f64, e - 150)) as f32

# Ferric's probe input generator (xorshift64*, mantissa bitcast to
# [1, 2), minus 1.5).
pub fn det_inputs(n: i64, seed: u64) -> List[f32]
    var s = wmul(seed, 11400714819323198485) | 1
    var o: List[f32] = []
    for _ in 0..n
        s = s ^ (s << 13)
        s = s ^ (s >> 7)
        s = s ^ (s << 17)
        let v = f32_from_bits(1065353216 | ((s >> 41) as i64))
        o.push(v - (1.5 as f32))
    return o

# FNV-1a 64 over the little-endian bytes of each f32, as 16 hex digits.
pub fn probe_digest(xs: &[f32]) -> text
    var h: u64 = 14695981039346656037
    for x in xs
        let b = f32_bits(x)
        for k in 0..4
            h = h ^ (((b >> (8 * k)) & 255) as u64)
            h = wmul(h, 1099511628211)
    return hex16(h)

# Ferric matmul_cpu / MATMUL_WGSL in binary32: left fold from 0, each
# product rounded.
pub fn matmul_f32(a: &[f32], b: &[f32], m: i64, k: i64, n: i64) -> List[f32]
    var c: List[f32] = []
    for r in 0..m
        for col in 0..n
            var acc = 0.0 as f32
            for i in 0..k
                acc = acc + a[(r * k + i) as usize] * b[(i * n + col) as usize]
            c.push(acc)
    return c

fn recip32(y: f32) -> f32
    var r = f32_from_bits(2129859011 - f32_bits(y))
    for _ in 0..3
        let t = y * r
        let ww = (2.0 as f32) - t
        r = r * ww
    return r

fn rsqrt32(y: f32) -> f32
    let hy = (0.5 as f32) * y
    var r = f32_from_bits(1597463007 - (f32_bits(y) >> 1))
    for _ in 0..3
        let t = r * r
        let u = hy * t
        let ww = (1.5 as f32) - u
        r = r * ww
    return r

# Ferric rmsnorm_tree (64 strided partials, class (li+1) mod 64, a fixed
# 6-level tree, Newton recip and rsqrt), binary32.
pub fn rmsnorm_tree_f32(x: &[f32], w: &[f32], nrows: i64, d: i64, eps: f32) -> List[f32]
    var out: List[f32] = []
    for row in 0..nrows
        let base = row * d
        var red: List[f32] = []
        for li in 0..64
            let cls = (li + 1) & 63
            var p = 0.0 as f32
            var j = cls
            while j < d bound 1099511627776
                let sq = x[(base + j) as usize] * x[(base + j) as usize]
                p = p + sq
                j += 64
            red.push(p)
        var s = 32
        while s >= 1 bound 7
            for li in 0..s
                red[li as usize] = red[li as usize] + red[(li + s) as usize]
            s = s / 2
        let ms = red[0] * recip32(d as f32)
        let inv = rsqrt32(ms + eps)
        for j in 0..d
            let t = x[(base + j) as usize] * inv
            out.push(t * w[j as usize])
    return out

# ---------------------------------------------------------------- FabricExec placement

# The engine's placement executor (openIE-dev/rce, rce/host
# spec/checker/src/host.rs: FabricExec, probe_fabric, place_from) admits
# a fabric for a class only through two logged entries: host.Calibrated
# (overhead, throughput) and a host.Exact whose probe digest equals the
# CPU reference digest. A wgpu backend such as Ferric enters by
# implementing FabricExec {id, lanes(op, a, b), sum(xs)} for the classes
# below. ml.tensor routes its sums (tree T18) and lane-wise ops through
# the same classes and makes the same choice from the same entries, so
# replay places identically.
#
# Ferric computes in binary32 only, so it cannot pass the binary64
# probes; its f32 kernels (f32.mm, f32.rmsnorm_tree) are the "verified,
# checked against a logged digest per device" case of HC-13, with the
# reference digest computed here.

pub struct Calibrated
    fabric: text
    class: text
    overhead: f64
    throughput: f64

# The payload of a logged host.Exact entry (Appendix E, HC-13).
pub struct Exact
    fabric: text
    class: text
    probe: text
    reference: text

# The engine's CPU cost line (CPU_COST).
pub const CPU_OVERHEAD: f64 = 16.0
pub const CPU_THROUGHPUT: f64 = 1.0

# The classes a fabric can be admitted for.
pub fn fabric_classes() -> List[text] = ["sum.f64", "lanes.f64.add", "lanes.f64.sub", "lanes.f64.mul", "lanes.f64.div", "lanes.f64.neg", "lanes.f64.sqrt", "f32.mm", "f32.rmsnorm_tree"]

# The reference digest of a class: SHA-256 over the probe results as
# 16-hex-digit bit patterns, the probe vector of host.rs (signed zeros,
# subnormal results, infinities, NaN, every sum length up to 64). Those
# vectors contain non-finite values, which trap in RCE (6.3 F4), so the
# binary64 digests are constants taken from the engine itself (an
# instrumented host.rs run at b497ce3, matched by
# scripts/ref/ml/fabric_exec_ref.py); the finite part of each probe is
# recomputed here by the checks. "" for an unknown class.
pub fn reference_digest(class: text) -> text
    if class == "sum.f64"
        return "d7dac1f1b21ccf82685814f699c40aad0e8ec7fba3ce0c4eaa1bf1222b622328"
    if class == "lanes.f64.add"
        return "17c4b97399ef559c305223da90ef0ebfd07262c151413c493595c27f59226a8a"
    if class == "lanes.f64.sub"
        return "65fc1cd817be59ae9eab3f4d37c9b847b1465216b9d1cdb969efbbb45b2dea72"
    if class == "lanes.f64.mul"
        return "6485f9d5ab55f621dd6712c7b687012023c9288264cdc0e53a6c839b43f4fa4f"
    if class == "lanes.f64.div"
        return "faa833990fbe4042d7a61347f171b4f405bf7c56691dde098ffe5440ea94922e"
    if class == "lanes.f64.neg"
        return "8553e6a41bc57f079bff74fe77c5ee1cbcdcafdce3b3c0b67f6c7df5ae673ee2"
    if class == "lanes.f64.sqrt"
        return "58693be7ce9c1d3794ed2f72f2c5f9f3da59caf6ce3d402f0051702b9657f270"
    let x = det_inputs(768, 1)
    if class == "f32.mm"
        let w = det_inputs(4096, 2)
        let r = matmul_f32(&x, &w, 12, 64, 64)
        return probe_digest(&r)
    if class == "f32.rmsnorm_tree"
        let w3 = det_inputs(64, 3)
        var wn: List[f32] = []
        for v in w3
            wn.push(v + (1.0 as f32))
        let r = rmsnorm_tree_f32(&x, &wn, 12, 64, 1.0e-5 as f32)
        return probe_digest(&r)
    return ""

# A fabric is admitted for a class by any logged probe whose digest equals
# both the logged reference and the reference computed here.
pub fn admitted(fabric: &text, class: &text, exacts: &[Exact]) -> bool
    let want = reference_digest(copy(class))
    if want == ""
        return false
    for e in exacts
        if e.fabric == fabric and e.class == class and e.probe == want and e.reference == want
            return true
    return false

# place_from: the least overhead + work / throughput among the CPU and
# every calibrated, admitted fabric; ties go to the CPU, then to the
# lexically smaller fabric id. A function of logged entries only.
pub fn place(class: text, work: f64, calib: &[Calibrated], exacts: &[Exact]) -> text
    var best = "cpu"
    var bt = CPU_OVERHEAD + work / CPU_THROUGHPUT
    for c in calib
        if c.class == class and c.throughput > 0.0 and admitted(&c.fabric, &c.class, exacts)
            let t = c.overhead + work / c.throughput
            if t < bt or (t == bt and best != "cpu" and c.fabric < best)
                best = copy(c.fabric)
                bt = t
    return best

# The placement class of a lane-wise op code of `zip` (0 add, 1 sub, 2 mul).
pub fn lanes_class(op: i64) -> text = if op == 0 then "lanes.f64.add" else (if op == 1 then "lanes.f64.sub" else "lanes.f64.mul")

# A placed sum: the fabric and the T18 sum. A fabric admitted by HC-13
# returns these bits by contract, so the value is computed on the
# reference here and the fabric choice is logged by the caller.
pub fn placed_sum(xs: &[f64], calib: &[Calibrated], exacts: &[Exact]) -> (text, f64)
    let f = place("sum.f64", xs.len() as f64, calib, exacts)
    return (f, reduce(xs, T18))
